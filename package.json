{
  "name": "bitpodrss",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first RSS reader and Podcasting 2.0 player with Lightning (Alby) payments, Bitcoin price charts, local transcription and optional Nostr identity.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "vite build && tsx e2e/run.ts",
    "serve": "vite build && tsx server/index.ts"
  },
  "dependencies": {
    "@getalby/lightning-tools": "^9.0.1",
    "@getalby/sdk": "^8.0.3",
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.11.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
